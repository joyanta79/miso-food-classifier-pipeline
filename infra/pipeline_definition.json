{
  "Parameters": [
    {
      "DefaultValue": "us-west-2",
      "Description": "AWS Region hosting this pipeline.",
      "Name": "Region",
      "Type": "String"
    },
    {
      "DefaultValue": "<replace-with-account-id>",
      "Description": "Target AWS account identifier.",
      "Name": "AccountId",
      "Type": "String"
    },
    {
      "DefaultValue": "white-castle",
      "Description": "Fixed pipeline brand identifier.",
      "Name": "BrandId",
      "Type": "String"
    },
    {
      "DefaultValue": "wc_*",
      "Description": "Allowed raw-data filename prefix pattern.",
      "Name": "BrandNamingPattern",
      "Type": "String"
    },
    {
      "DefaultValue": "FoodClassifier-WhiteCastle",
      "Description": "Brand-specific SageMaker Model Registry package group.",
      "Name": "ModelPackageGroup",
      "Type": "String"
    },
    {
      "DefaultValue": 6,
      "Description": "Maximum image age to select.",
      "Name": "RecencyMonths",
      "Type": "Integer"
    },
    {
      "DefaultValue": "imagenet",
      "Description": "Embedding backbone provenance.",
      "Name": "BackboneSource",
      "Type": "String"
    },
    {
      "DefaultValue": "<replace-with-prior-production-backbone-path>",
      "Description": "Prior-production backbone path used for embeddings.",
      "Name": "BackboneModelPath",
      "Type": "String"
    },
    {
      "DefaultValue": 1280,
      "Description": "Embedding vector dimensionality.",
      "Name": "EmbeddingDim",
      "Type": "Integer"
    },
    {
      "DefaultValue": 0.99,
      "Description": "Cosine similarity above which an image is deduplicated.",
      "Name": "CosineDedupThreshold",
      "Type": "Float"
    },
    {
      "DefaultValue": 5,
      "Description": "Number of cross-validation folds.",
      "Name": "KFoldCount",
      "Type": "Integer"
    },
    {
      "DefaultValue": "xgboost",
      "Description": "Classifier implementation used for training.",
      "Name": "Classifier",
      "Type": "String"
    },
    {
      "DefaultValue": "ml.g4dn.xlarge",
      "Description": "SageMaker training instance type.",
      "Name": "TrainingInstanceType",
      "Type": "String"
    },
    {
      "DefaultValue": "ml.m5.xlarge",
      "Description": "SageMaker processing instance type.",
      "Name": "ProcessingInstanceType",
      "Type": "String"
    },
    {
      "DefaultValue": true,
      "Description": "Whether managed spot training is enabled.",
      "Name": "UseSpot",
      "Type": "Boolean"
    },
    {
      "DefaultValue": 50,
      "Description": "Maximum training epochs.",
      "Name": "Epochs",
      "Type": "Integer"
    },
    {
      "DefaultValue": 32,
      "Description": "Training batch size.",
      "Name": "BatchSize",
      "Type": "Integer"
    },
    {
      "DefaultValue": 0.001,
      "Description": "Training learning rate.",
      "Name": "LearningRate",
      "Type": "Float"
    },
    {
      "DefaultValue": 5,
      "Description": "Epoch interval for persisted training checkpoints.",
      "Name": "CheckpointEveryEpochs",
      "Type": "Integer"
    },
    {
      "DefaultValue": 224,
      "Description": "Square input image size in pixels.",
      "Name": "ImageSize",
      "Type": "Integer"
    },
    {
      "DefaultValue": 0.85,
      "Description": "Reference confidence level for drift detection.",
      "Name": "ConfidenceBaseline",
      "Type": "Float"
    },
    {
      "DefaultValue": 0.7,
      "Description": "Level 2 escalation confidence threshold.",
      "Name": "Level2ConfidenceThreshold",
      "Type": "Float"
    },
    {
      "DefaultValue": "<replace-with-review-sns-topic-arn>",
      "Description": "Human review notification topic.",
      "Name": "ReviewTopicArn",
      "Type": "String"
    },
    {
      "DefaultValue": "<replace-with-ml-lead-sns-topic-arn>",
      "Description": "ML lead notification topic.",
      "Name": "MlLeadTopicArn",
      "Type": "String"
    },
    {
      "DefaultValue": "<replace-with-vp-engineering-sns-topic-arn>",
      "Description": "VP Engineering escalation notification topic.",
      "Name": "VpEngineeringTopicArn",
      "Type": "String"
    },
    {
      "DefaultValue": true,
      "Description": "Whether local dry-run support is enabled.",
      "Name": "LocalModeEnabled",
      "Type": "Boolean"
    },
    {
      "DefaultValue": true,
      "Description": "Whether local mode uses mocked AWS services.",
      "Name": "MockAws",
      "Type": "Boolean"
    },
    {
      "DefaultValue": false,
      "Description": "Whether local mode loads ImageNet weights.",
      "Name": "UseImagenetWeights",
      "Type": "Boolean"
    },
    {
      "DefaultValue": 2026,
      "Description": "Deterministic local-mode random seed.",
      "Name": "Seed",
      "Type": "Integer"
    }
  ],
  "Steps": [
    {
      "Arguments": {
        "AppSpecification": {
          "ContainerEntrypoint": [
            "python3",
            "/opt/ml/processing/input/code/data_selection.py"
          ],
          "ImageUri": "683313688378.dkr.ecr.us-west-2.amazonaws.com/sagemaker-scikit-learn:1.2-1-cpu-py3"
        },
        "Environment": {
          "BRAND_ID": {
            "Get": "Parameters.BrandId"
          },
          "MIN_IMAGES_PER_CLASS": "500",
          "NAMING_PATTERN": {
            "Get": "Parameters.BrandNamingPattern"
          },
          "RECENCY_MONTHS": {
            "Get": "Parameters.RecencyMonths"
          },
          "SEED": {
            "Get": "Parameters.Seed"
          },
          "TARGET_DATASET_MAX": "50000",
          "TARGET_DATASET_MIN": "6000"
        },
        "ProcessingInputs": [
          {
            "InputName": "raw-archive",
            "S3Input": {
              "LocalPath": "/opt/ml/processing/input/raw",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File",
              "S3Uri": "s3://<replace-raw-archive-bucket>/white-castle"
            }
          },
          {
            "InputName": "pipeline-code",
            "S3Input": {
              "LocalPath": "/opt/ml/processing/input/code",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File",
              "S3Uri": "s3://<replace-pipeline-artifacts-bucket>/code"
            }
          }
        ],
        "ProcessingOutputConfig": {
          "Outputs": [
            {
              "OutputName": "selected-dataset",
              "S3Output": {
                "LocalPath": "/opt/ml/processing/output/dataset",
                "S3UploadMode": "EndOfJob",
                "S3Uri": "s3://<replace-training-bucket>/white-castle/selected"
              }
            },
            {
              "OutputName": "selection-metrics",
              "S3Output": {
                "LocalPath": "/opt/ml/processing/output/metrics",
                "S3UploadMode": "EndOfJob",
                "S3Uri": "s3://<replace-pipeline-artifacts-bucket>/white-castle/selection"
              }
            }
          ]
        },
        "ProcessingResources": {
          "ClusterConfig": {
            "InstanceCount": 1,
            "InstanceType": {
              "Get": "Parameters.ProcessingInstanceType"
            },
            "VolumeSizeInGB": 30
          }
        },
        "RoleArn": "<replace-with-sagemaker-role-arn>"
      },
      "Name": "SelectRecentBrandData",
      "PropertyFiles": [
        {
          "OutputName": "selection-metrics",
          "Path": "metrics.json",
          "PropertyFileName": "SelectionMetrics"
        }
      ],
      "Type": "Processing"
    },
    {
      "Arguments": {
        "Conditions": [
          {
            "LeftValue": {
              "Std:JsonGet": {
                "Path": "dataset_size",
                "PropertyFile": {
                  "Get": "Steps.SelectRecentBrandData.PropertyFiles.SelectionMetrics"
                }
              }
            },
            "RightValue": 6000,
            "Type": "ConditionGreaterThanOrEqualTo"
          },
          {
            "LeftValue": {
              "Std:JsonGet": {
                "Path": "dataset_size",
                "PropertyFile": {
                  "Get": "Steps.SelectRecentBrandData.PropertyFiles.SelectionMetrics"
                }
              }
            },
            "RightValue": 50000,
            "Type": "ConditionLessThanOrEqualTo"
          },
          {
            "LeftValue": {
              "Std:JsonGet": {
                "Path": "minimum_class_count",
                "PropertyFile": {
                  "Get": "Steps.SelectRecentBrandData.PropertyFiles.SelectionMetrics"
                }
              }
            },
            "RightValue": 500,
            "Type": "ConditionGreaterThanOrEqualTo"
          }
        ],
        "ElseSteps": [
          {
            "Arguments": {
              "ErrorMessage": "Selected dataset is outside configured size or class-coverage bounds."
            },
            "Name": "FailDatasetBounds",
            "Type": "Fail"
          }
        ],
        "IfSteps": [
          {
            "Arguments": {
              "AppSpecification": {
                "ContainerEntrypoint": [
                  "python3",
                  "/opt/ml/processing/input/code/embedding_dedup.py"
                ],
                "ImageUri": "683313688378.dkr.ecr.us-west-2.amazonaws.com/sagemaker-scikit-learn:1.2-1-cpu-py3"
              },
              "Environment": {
                "BACKBONE_MODEL_PATH": {
                  "Get": "Parameters.BackboneModelPath"
                },
                "BACKBONE_SOURCE": {
                  "Get": "Parameters.BackboneSource"
                },
                "COSINE_DEDUP_THRESHOLD": {
                  "Get": "Parameters.CosineDedupThreshold"
                },
                "EMBEDDING_DIM": {
                  "Get": "Parameters.EmbeddingDim"
                },
                "SEED": {
                  "Get": "Parameters.Seed"
                },
                "USE_IMAGENET_WEIGHTS": {
                  "Get": "Parameters.UseImagenetWeights"
                }
              },
              "ProcessingInputs": [
                {
                  "InputName": "selected-dataset",
                  "S3Input": {
                    "LocalPath": "/opt/ml/processing/input/dataset",
                    "S3DataType": "S3Prefix",
                    "S3InputMode": "File",
                    "S3Uri": "s3://<replace-training-bucket>/white-castle/selected"
                  }
                },
                {
                  "InputName": "pipeline-code",
                  "S3Input": {
                    "LocalPath": "/opt/ml/processing/input/code",
                    "S3DataType": "S3Prefix",
                    "S3InputMode": "File",
                    "S3Uri": "s3://<replace-pipeline-artifacts-bucket>/code"
                  }
                }
              ],
              "ProcessingOutputConfig": {
                "Outputs": [
                  {
                    "OutputName": "deduplicated-dataset",
                    "S3Output": {
                      "LocalPath": "/opt/ml/processing/output/dataset",
                      "S3UploadMode": "EndOfJob",
                      "S3Uri": "s3://<replace-training-bucket>/white-castle/deduplicated"
                    }
                  }
                ]
              },
              "ProcessingResources": {
                "ClusterConfig": {
                  "InstanceCount": 1,
                  "InstanceType": {
                    "Get": "Parameters.ProcessingInstanceType"
                  },
                  "VolumeSizeInGB": 30
                }
              },
              "RoleArn": "<replace-with-sagemaker-role-arn>"
            },
            "Name": "EmbedAndDeduplicate",
            "Type": "Processing"
          },
          {
            "Arguments": {
              "AppSpecification": {
                "ContainerEntrypoint": [
                  "python3",
                  "/opt/ml/processing/input/code/kfold_cleanlab.py"
                ],
                "ImageUri": "683313688378.dkr.ecr.us-west-2.amazonaws.com/sagemaker-scikit-learn:1.2-1-cpu-py3"
              },
              "Environment": {
                "CLASSIFIER": {
                  "Get": "Parameters.Classifier"
                },
                "CLEANLAB_FLAG_THRESHOLD_FRACTION": "0.05",
                "KFOLD_COUNT": {
                  "Get": "Parameters.KFoldCount"
                },
                "MIN_IMAGES_PER_CLASS": "500",
                "SEED": {
                  "Get": "Parameters.Seed"
                },
                "TARGET_DATASET_MIN": "6000"
              },
              "ProcessingInputs": [
                {
                  "InputName": "deduplicated-dataset",
                  "S3Input": {
                    "LocalPath": "/opt/ml/processing/input/dataset",
                    "S3DataType": "S3Prefix",
                    "S3InputMode": "File",
                    "S3Uri": "s3://<replace-training-bucket>/white-castle/deduplicated"
                  }
                },
                {
                  "InputName": "pipeline-code",
                  "S3Input": {
                    "LocalPath": "/opt/ml/processing/input/code",
                    "S3DataType": "S3Prefix",
                    "S3InputMode": "File",
                    "S3Uri": "s3://<replace-pipeline-artifacts-bucket>/code"
                  }
                }
              ],
              "ProcessingOutputConfig": {
                "Outputs": [
                  {
                    "OutputName": "quality-dataset",
                    "S3Output": {
                      "LocalPath": "/opt/ml/processing/output/dataset",
                      "S3UploadMode": "EndOfJob",
                      "S3Uri": "s3://<replace-training-bucket>/white-castle/quality"
                    }
                  },
                  {
                    "OutputName": "quality-metrics",
                    "S3Output": {
                      "LocalPath": "/opt/ml/processing/output/metrics",
                      "S3UploadMode": "EndOfJob",
                      "S3Uri": "s3://<replace-pipeline-artifacts-bucket>/white-castle/quality"
                    }
                  }
                ]
              },
              "ProcessingResources": {
                "ClusterConfig": {
                  "InstanceCount": 1,
                  "InstanceType": {
                    "Get": "Parameters.ProcessingInstanceType"
                  },
                  "VolumeSizeInGB": 30
                }
              },
              "RoleArn": "<replace-with-sagemaker-role-arn>"
            },
            "Name": "KFoldCleanlabQuality",
            "PropertyFiles": [
              {
                "OutputName": "quality-metrics",
                "Path": "metrics.json",
                "PropertyFileName": "QualityMetrics"
              }
            ],
            "Type": "Processing"
          },
          {
            "Arguments": {
              "Conditions": [
                {
                  "LeftValue": {
                    "Std:JsonGet": {
                      "Path": "flagged_fraction",
                      "PropertyFile": {
                        "Get": "Steps.KFoldCleanlabQuality.PropertyFiles.QualityMetrics"
                      }
                    }
                  },
                  "RightValue": 0.05,
                  "Type": "ConditionLessThanOrEqualTo"
                },
                {
                  "LeftValue": {
                    "Std:JsonGet": {
                      "Path": "detector",
                      "PropertyFile": {
                        "Get": "Steps.KFoldCleanlabQuality.PropertyFiles.QualityMetrics"
                      }
                    }
                  },
                  "RightValue": "cleanlab",
                  "Type": "ConditionEquals"
                },
                {
                  "LeftValue": {
                    "Std:JsonGet": {
                      "Path": "cleaned_count",
                      "PropertyFile": {
                        "Get": "Steps.KFoldCleanlabQuality.PropertyFiles.QualityMetrics"
                      }
                    }
                  },
                  "RightValue": 6000,
                  "Type": "ConditionGreaterThanOrEqualTo"
                },
                {
                  "LeftValue": {
                    "Std:JsonGet": {
                      "Path": "minimum_class_count",
                      "PropertyFile": {
                        "Get": "Steps.KFoldCleanlabQuality.PropertyFiles.QualityMetrics"
                      }
                    }
                  },
                  "RightValue": 500,
                  "Type": "ConditionGreaterThanOrEqualTo"
                }
              ],
              "ElseSteps": [
                {
                  "Arguments": {
                    "ErrorMessage": "Cleanlab flagged label fraction exceeds the configured threshold."
                  },
                  "Name": "FailCleanlabQuality",
                  "Type": "Fail"
                }
              ],
              "IfSteps": [
                {
                  "Arguments": {
                    "AppSpecification": {
                      "ContainerEntrypoint": [
                        "python3",
                        "/opt/ml/processing/input/code/drift_detection.py"
                      ],
                      "ImageUri": "683313688378.dkr.ecr.us-west-2.amazonaws.com/sagemaker-scikit-learn:1.2-1-cpu-py3"
                    },
                    "Environment": {
                      "CONFIDENCE_BASELINE": {
                        "Get": "Parameters.ConfidenceBaseline"
                      },
                      "CORRECTION_RATE_MULTIPLIER": "3",
                      "LEVEL1_CONFIDENCE_FLOOR": "0.65",
                      "LEVEL2_CONFIDENCE_THRESHOLD": {
                        "Get": "Parameters.Level2ConfidenceThreshold"
                      }
                    },
                    "ProcessingInputs": [
                      {
                        "InputName": "quality-dataset",
                        "S3Input": {
                          "LocalPath": "/opt/ml/processing/input/dataset",
                          "S3DataType": "S3Prefix",
                          "S3InputMode": "File",
                          "S3Uri": "s3://<replace-training-bucket>/white-castle/quality"
                        }
                      },
                      {
                        "InputName": "pipeline-code",
                        "S3Input": {
                          "LocalPath": "/opt/ml/processing/input/code",
                          "S3DataType": "S3Prefix",
                          "S3InputMode": "File",
                          "S3Uri": "s3://<replace-pipeline-artifacts-bucket>/code"
                        }
                      }
                    ],
                    "ProcessingOutputConfig": {
                      "Outputs": [
                        {
                          "OutputName": "drift-metrics",
                          "S3Output": {
                            "LocalPath": "/opt/ml/processing/output/metrics",
                            "S3UploadMode": "EndOfJob",
                            "S3Uri": "s3://<replace-pipeline-artifacts-bucket>/white-castle/drift"
                          }
                        }
                      ]
                    },
                    "ProcessingResources": {
                      "ClusterConfig": {
                        "InstanceCount": 1,
                        "InstanceType": {
                          "Get": "Parameters.ProcessingInstanceType"
                        },
                        "VolumeSizeInGB": 30
                      }
                    },
                    "RoleArn": "<replace-with-sagemaker-role-arn>"
                  },
                  "Name": "DetectDrift",
                  "PropertyFiles": [
                    {
                      "OutputName": "drift-metrics",
                      "Path": "metrics.json",
                      "PropertyFileName": "DriftMetrics"
                    }
                  ],
                  "Type": "Processing"
                },
                {
                  "Arguments": {
                    "Conditions": [
                      {
                        "LeftValue": {
                          "Std:JsonGet": {
                            "Path": "confidence",
                            "PropertyFile": {
                              "Get": "Steps.DetectDrift.PropertyFiles.DriftMetrics"
                            }
                          }
                        },
                        "RightValue": 0.65,
                        "Type": "ConditionGreaterThanOrEqualTo"
                      },
                      {
                        "LeftValue": {
                          "Std:JsonGet": {
                            "Path": "correction_rate_multiplier",
                            "PropertyFile": {
                              "Get": "Steps.DetectDrift.PropertyFiles.DriftMetrics"
                            }
                          }
                        },
                        "RightValue": 3,
                        "Type": "ConditionLessThanOrEqualTo"
                      }
                    ],
                    "ElseSteps": [
                      {
                        "Arguments": {
                          "ErrorMessage": "Drift metrics exceed the configured confidence or correction-rate limits."
                        },
                        "Name": "FailDriftGate",
                        "Type": "Fail"
                      }
                    ],
                    "IfSteps": [
                      {
                        "Arguments": {
                          "AlgorithmSpecification": {
                            "ContainerEntrypoint": [
                              "python3",
                              "/opt/ml/input/data/code/train.py"
                            ],
                            "TrainingImage": "433757028032.dkr.ecr.us-west-2.amazonaws.com/xgboost:1.7-1",
                            "TrainingInputMode": "File"
                          },
                          "CheckpointConfig": {
                            "S3Uri": "s3://<replace-model-artifacts-bucket>/white-castle/checkpoints"
                          },
                          "EnableManagedSpotTraining": {
                            "Get": "Parameters.UseSpot"
                          },
                          "HyperParameters": {
                            "batch_size": {
                              "Get": "Parameters.BatchSize"
                            },
                            "checkpoint_every_epochs": {
                              "Get": "Parameters.CheckpointEveryEpochs"
                            },
                            "classifier": {
                              "Get": "Parameters.Classifier"
                            },
                            "epochs": {
                              "Get": "Parameters.Epochs"
                            },
                            "image_size": {
                              "Get": "Parameters.ImageSize"
                            },
                            "learning_rate": {
                              "Get": "Parameters.LearningRate"
                            },
                            "seed": {
                              "Get": "Parameters.Seed"
                            }
                          },
                          "InputDataConfig": [
                            {
                              "ChannelName": "training",
                              "DataSource": {
                                "S3DataSource": {
                                  "S3DataDistributionType": "FullyReplicated",
                                  "S3DataType": "S3Prefix",
                                  "S3Uri": "s3://<replace-training-bucket>/white-castle/quality"
                                }
                              }
                            },
                            {
                              "ChannelName": "code",
                              "DataSource": {
                                "S3DataSource": {
                                  "S3DataDistributionType": "FullyReplicated",
                                  "S3DataType": "S3Prefix",
                                  "S3Uri": "s3://<replace-pipeline-artifacts-bucket>/code"
                                }
                              }
                            }
                          ],
                          "OutputDataConfig": {
                            "S3OutputPath": "s3://<replace-model-artifacts-bucket>/white-castle"
                          },
                          "ResourceConfig": {
                            "InstanceCount": 1,
                            "InstanceType": {
                              "Get": "Parameters.TrainingInstanceType"
                            },
                            "VolumeSizeInGB": 50
                          },
                          "RoleArn": "<replace-with-sagemaker-role-arn>",
                          "StoppingCondition": {
                            "MaxRuntimeInSeconds": 86400,
                            "MaxWaitTimeInSeconds": 172800
                          },
                          "Tags": [
                            {
                              "Key": "brand",
                              "Value": {
                                "Get": "Parameters.BrandId"
                              }
                            }
                          ]
                        },
                        "Name": "TrainBrandClassifier",
                        "Type": "Training"
                      },
                      {
                        "Arguments": {
                          "AppSpecification": {
                            "ContainerEntrypoint": [
                              "python3",
                              "/opt/ml/processing/input/code/evaluation.py"
                            ],
                            "ImageUri": "683313688378.dkr.ecr.us-west-2.amazonaws.com/sagemaker-scikit-learn:1.2-1-cpu-py3"
                          },
                          "Environment": {
                            "ACCURACY_THRESHOLD": "0.97",
                            "FP_RATE_EMERGENCY_THRESHOLD": "0.05",
                            "LATENCY_BUDGET_MS": "1000"
                          },
                          "ProcessingInputs": [
                            {
                              "InputName": "model-artifacts",
                              "S3Input": {
                                "LocalPath": "/opt/ml/processing/input/model",
                                "S3DataType": "S3Prefix",
                                "S3InputMode": "File",
                                "S3Uri": "s3://<replace-model-artifacts-bucket>/white-castle"
                              }
                            },
                            {
                              "InputName": "pipeline-code",
                              "S3Input": {
                                "LocalPath": "/opt/ml/processing/input/code",
                                "S3DataType": "S3Prefix",
                                "S3InputMode": "File",
                                "S3Uri": "s3://<replace-pipeline-artifacts-bucket>/code"
                              }
                            }
                          ],
                          "ProcessingOutputConfig": {
                            "Outputs": [
                              {
                                "OutputName": "evaluation-metrics",
                                "S3Output": {
                                  "LocalPath": "/opt/ml/processing/output/metrics",
                                  "S3UploadMode": "EndOfJob",
                                  "S3Uri": "s3://<replace-pipeline-artifacts-bucket>/white-castle/evaluation"
                                }
                              }
                            ]
                          },
                          "ProcessingResources": {
                            "ClusterConfig": {
                              "InstanceCount": 1,
                              "InstanceType": {
                                "Get": "Parameters.ProcessingInstanceType"
                              },
                              "VolumeSizeInGB": 30
                            }
                          },
                          "RoleArn": "<replace-with-sagemaker-role-arn>"
                        },
                        "Name": "EvaluateModel",
                        "PropertyFiles": [
                          {
                            "OutputName": "evaluation-metrics",
                            "Path": "metrics.json",
                            "PropertyFileName": "EvaluationMetrics"
                          }
                        ],
                        "Type": "Processing"
                      },
                      {
                        "Arguments": {
                          "Conditions": [
                            {
                              "LeftValue": {
                                "Std:JsonGet": {
                                  "Path": "accuracy",
                                  "PropertyFile": {
                                    "Get": "Steps.EvaluateModel.PropertyFiles.EvaluationMetrics"
                                  }
                                }
                              },
                              "RightValue": 0.97,
                              "Type": "ConditionGreaterThanOrEqualTo"
                            },
                            {
                              "LeftValue": {
                                "Std:JsonGet": {
                                  "Path": "emergency_false_positive_rate",
                                  "PropertyFile": {
                                    "Get": "Steps.EvaluateModel.PropertyFiles.EvaluationMetrics"
                                  }
                                }
                              },
                              "RightValue": 0.05,
                              "Type": "ConditionLessThanOrEqualTo"
                            },
                            {
                              "LeftValue": {
                                "Std:JsonGet": {
                                  "Path": "latency_ms",
                                  "PropertyFile": {
                                    "Get": "Steps.EvaluateModel.PropertyFiles.EvaluationMetrics"
                                  }
                                }
                              },
                              "RightValue": 1000,
                              "Type": "ConditionLessThanOrEqualTo"
                            }
                          ],
